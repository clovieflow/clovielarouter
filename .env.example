# ── App ─────────────────────────────────────────────
PORT=8787
APP_URL=http://localhost:5177

# Base URL API yang dipakai user (default: APP_URL + /v1)
# Isi kalau endpoint publik beda, mis. https://api.cloviela.my.id/v1
PUBLIC_API_BASE=

# Harga paket (flat, unlimited)
PRICE_IDR=15000
PLAN_DAYS=7

# ── Rate limit (0 = matikan) ────────────────────────
GLOBAL_RPM=60
GLOBAL_CONCURRENT=5
USER_RPM=30
USER_CONCURRENT=3


# Metode pembayaran yang ditawarkan (default: qris saja)
PAYMENT_METHODS=qris

# ── Paymenku (paymenku.com) ─────────────────────────
# Ambil di Dashboard Merchant → Settings → API Keys
# sk_test_… untuk sandbox, sk_live_… untuk production
PAYMENKU_API_KEY=
# Settings → Webhook → copy Webhook Secret
PAYMENKU_WEBHOOK_SECRET=
# (dev) arahkan ke mock: http://localhost:9099/api/v1 — kosongkan untuk production
PAYMENKU_BASE=
# Webhook URL yang didaftarkan di dashboard: https://domain-kamu/api/webhook/paymenku

# ── Firebase (Auth + Firestore) ─────────────────────
# Project: cloviela1 — app "cloviela web"
# Nilai di bawah dari: npx firebase-tools apps:sdkconfig WEB <APP_ID>
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=cloviela1.firebaseapp.com
FIREBASE_PROJECT_ID=cloviela1
FIREBASE_STORAGE_BUCKET=cloviela1.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Kredensial server (Admin SDK) — pilih salah satu:
#   1) FIREBASE_SERVICE_ACCOUNT=<json string>       (untuk deploy/env var)
#   2) FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json

# ── Admin ───────────────────────────────────────────
# Email Google yang boleh masuk admin panel (pisah dengan koma)
ADMIN_EMAILS=kamu@gmail.com

# ── Telegram (notifikasi admin saja, bukan ke user) ─
# Bikin bot via @BotFather → token
TELEGRAM_BOT_TOKEN=
# Chat ID kamu: kirim pesan ke bot, buka
# https://api.telegram.org/bot<TOKEN>/getUpdates → lihat "chat":{"id":…}
TELEGRAM_ADMIN_CHAT_ID=

# ── Database ────────────────────────────────────────
DB_PATH=data/cloviela.db

# ── Pembayaran crypto (Solana) ──
# Alamat dikelola dari Admin Panel -> tab Crypto (tersimpan di Firestore settings/crypto).
# RPC Solana untuk verifikasi pembayaran otomatis:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
