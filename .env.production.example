# ── Cloviela Router — production (VPS) ─────────────────────────
# Cara pakai:
#   cp .env.production.example .env
#   nano .env          (isi semua nilai)
#   npm run deploy:vps

# ── App ─────────────────────────────────────────────
PORT=8787
# URL publik VPS kamu — dipakai untuk return_url pembayaran
APP_URL=https://router.cloviela.my.id

# Base URL API yang dipakai user (default: APP_URL + /v1)
PUBLIC_API_BASE=
NODE_ENV=production

# Harga paket (flat, unlimited)
PRICE_IDR=15000
PLAN_DAYS=7

# ── Rate limit (0 = matikan) ────────────────────────
# Global: melindungi provider dari lonjakan total
GLOBAL_RPM=60
GLOBAL_CONCURRENT=5
# Per user: cegah 1 akun menghabiskan kuota global
USER_RPM=30
USER_CONCURRENT=3


# Metode pembayaran yang ditawarkan (default: qris saja)
PAYMENT_METHODS=qris

# ── Paymenku (paymenku.com) ─────────────────────────
# Dashboard Merchant → Settings → API Keys
PAYMENKU_API_KEY=sk_live_xxxxxxxxxxxx
# Dashboard → Settings → Webhook
PAYMENKU_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# JANGAN diisi di production (biarkan kosong = pakai Paymenku asli)
PAYMENKU_BASE=

# ── Firebase project cloviela1 ──────────────────────
FIREBASE_API_KEY=AIzaSyDAIf-YBTqwJ9YRawMyHccoUZwmRAjEO7U
FIREBASE_AUTH_DOMAIN=cloviela1.firebaseapp.com
FIREBASE_PROJECT_ID=cloviela1
FIREBASE_STORAGE_BUCKET=cloviela1.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=513134013669
FIREBASE_APP_ID=1:513134013669:web:7d9dd2652bf20ef153f80c

# Kredensial server (Admin SDK) — pilih SALAH SATU:
#   A) file (paling gampang di VPS)
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/firebase-service-account.json
#   B) isi JSON-nya langsung sebagai satu baris (kalau tidak mau taruh file)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"cloviela1",...}

# ── Admin ───────────────────────────────────────────
# Email Google yang boleh buka /admin (pisah dengan koma)
ADMIN_EMAILS=clovvalencied@gmail.com

# ── Telegram (notif pembelian ke admin) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── Pembayaran crypto (Solana) ──
# Alamat dikelola dari Admin Panel -> tab Crypto (tersimpan di Firestore settings/crypto).
# RPC Solana untuk verifikasi pembayaran otomatis:
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
